# Saloni server — copy to .env (or export) and adjust. Defaults shown match infra/docker-compose.yml.
# NODE_ENV is REQUIRED (development | test | production) — the server refuses to start without it.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Runtime connections — through PgBouncer (transaction pooling)
PG_HOST=127.0.0.1
PG_PORT=6432
PG_USER=saloni
PG_PASSWORD=saloni_dev_password

# Admin connections — DIRECT to PostgreSQL (CREATE DATABASE, migrations). Needs CREATEDB.
PG_ADMIN_HOST=127.0.0.1
PG_ADMIN_PORT=5432
PG_ADMIN_USER=saloni
PG_ADMIN_PASSWORD=saloni_dev_password
PG_ADMIN_MAINTENANCE_DB=postgres

DIRECTORY_DB_NAME=saloni_directory
SALON_DB_PREFIX=saloni_salon_
DIRECTORY_POOL_MAX=5
TENANT_POOL_MAX=3
TENANT_POOL_IDLE_TTL_MS=300000
TENANT_POOLS_MAX=200
DIRECTORY_CACHE_TTL_MS=5000

# Secrets — REQUIRED whenever NODE_ENV is not `test`, development included (>= 32 chars each, all
# different, no placeholders). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RESET_CODE_PEPPER=
JWT_ISSUER=saloni
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
RESET_CODE_TTL_HOURS=24
# A rotated refresh token may be re-presented ONCE within this many seconds (lost answer on a flaky network); 0 = off, max 120.
REFRESH_REUSE_GRACE_SEC=30

# Argon2id parameters (OWASP baseline: 19 MiB, t=2, p=1)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Proxies whose X-Forwarded-For is trusted: false, a hop count (1 behind one nginx) or a comma-separated
# list of proxy IPs/CIDRs (e.g. 127.0.0.1,10.0.0.0/8). `true` is refused in production. See README.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS (empty = CORS disabled; the mobile apps do not need it).
CORS_ORIGINS=

# Progressive login backoff (per account+IP; plus per IP across accounts)
BACKOFF_FREE_ATTEMPTS=3
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=900000
BACKOFF_IP_FREE_ATTEMPTS=20
BACKOFF_RESET_AFTER_MS=3600000
# Account-wide slow delay (all IPs together): never a lockout, at most BACKOFF_ACCOUNT_MAX_DELAY_MS
BACKOFF_ACCOUNT_FREE_ATTEMPTS=10
BACKOFF_ACCOUNT_BASE_MS=250
BACKOFF_ACCOUNT_MAX_DELAY_MS=3000

RATE_LIMITS_ENABLED=true
# Self-registration pauses while this many salons wait for activation (clean up: npm run vendor -- cleanup-pending)
MAX_PENDING_SALONS=50

# Uploaded images (logos, photos). Default ./storage-data
STORAGE_DIR=./storage-data

# Push notifications (FCM HTTP v1). Leave empty to disable sending (notifications are still recorded).
# Either a service-account JSON file, or the three fields (private key with \n escapes).
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Background scheduler (default: on, except NODE_ENV=test)
# SCHEDULER_ENABLED=true
