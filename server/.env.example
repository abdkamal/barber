# Saloni server — copy to .env (or export) and adjust. Defaults shown match infra/docker-compose.yml.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Runtime connections — through PgBouncer (transaction pooling)
PG_HOST=127.0.0.1
PG_PORT=6432
PG_USER=saloni
PG_PASSWORD=saloni_dev_password

# Admin connections — DIRECT to PostgreSQL (CREATE DATABASE, migrations). Needs CREATEDB.
PG_ADMIN_HOST=127.0.0.1
PG_ADMIN_PORT=5432
PG_ADMIN_USER=saloni
PG_ADMIN_PASSWORD=saloni_dev_password
PG_ADMIN_MAINTENANCE_DB=postgres

DIRECTORY_DB_NAME=saloni_directory
SALON_DB_PREFIX=saloni_salon_
DIRECTORY_POOL_MAX=5
TENANT_POOL_MAX=3
TENANT_POOL_IDLE_TTL_MS=300000
TENANT_POOLS_MAX=200
DIRECTORY_CACHE_TTL_MS=5000

# Secrets — REQUIRED in production (>= 32 chars each, all different). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RESET_CODE_PEPPER=
JWT_ISSUER=saloni
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
RESET_CODE_TTL_HOURS=24

# Argon2id parameters (OWASP baseline: 19 MiB, t=2, p=1)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Set to the number of trusted proxy hops (e.g. 1 behind nginx) so client IPs are correct.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS (empty = CORS disabled; the mobile apps do not need it).
CORS_ORIGINS=

# Progressive login backoff (per account+IP; plus per IP across accounts)
BACKOFF_FREE_ATTEMPTS=3
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=900000
BACKOFF_IP_FREE_ATTEMPTS=20
BACKOFF_RESET_AFTER_MS=3600000

RATE_LIMITS_ENABLED=true
