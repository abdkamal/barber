{
  "name": "@saloni/server",
  "version": "0.1.0",
  "private": true,
  "description": "Saloni (صالوني) API server — NestJS + PostgreSQL (directory DB + one DB per salon)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:engine": "npm run build -w @saloni/engine",
    "prebuild": "npm run build:engine",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "ts-node --transpile-only src/cli/migrate.ts",
    "vendor": "ts-node --transpile-only src/cli/vendor.ts",
    "test": "jest --config jest.config.js",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "prestart:dev": "npm run build:engine",
    "pretest:int": "npm run build:engine"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@saloni/engine": "0.1.0",
    "argon2": "^0.44.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
